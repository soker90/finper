# ── Base de datos (SQLite) ───────────────────────────────────────────────────
# Uso local (sin Docker): ruta relativa al proceso o absoluta.
DATABASE_FILE=./finper-dev.db

# Uso con Docker Compose: ruta DENTRO del contenedor.
# DATA_PATH (ver más abajo) se monta en /home/node/app/data.
# El default del compose es /home/node/app/data/finper.db (raíz del volumen).
# Descomenta y ajusta solo si quieres cambiar el nombre del fichero.
# DATABASE_FILE=/home/node/app/data/finper.db

# Ruta ABSOLUTA en el host que docker-compose.yml monta
# en /home/node/app/data. Ajusta a donde vive tu fichero SQLite real.
DATA_PATH=/volume1/docker/finper

# ── Autenticación JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_this_secret
SALT_ROUNDS=10

# ── Ticket bot / finper-bot ──────────────────────────────────────────────────
# Integración externa actual para el módulo de tickets
TICKET_BOT_URL=
TICKET_BOT_API_KEY=

# ── Seguridad y API ──────────────────────────────────────────────────────────
# Permite el registro abierto de usuarios en POST /api/auth/register
# Por defecto está desactivado (false) para evitar registros indeseados.
ALLOW_REGISTRATION=false

# Orígenes CORS adicionales separados por comas (ej: https://midominio.com).
# Nota: localhost y las IPs de red local (192.168.1.x) ya están permitidos
# por defecto sin necesidad de configurarlos aquí.
CORS_EXTRA_ORIGINS=

# ── Build del cliente (Docker) ───────────────────────────────────────────────
# Build-arg opcional para la imagen del cliente vía docker-compose.yml
# (packages/client/Dockerfile ya usa /api/ como default si no se define).
# NO afecta a `pnpm dev` en local, que sigue usando packages/client/.env
# (VITE_API_HOST).
# Descomenta solo si cliente y API van bajo hostnames distintos: pon aquí la
# URL absoluta de la API (ej: https://api.midominio.com/api/) y añade el
# origen del cliente a CORS_EXTRA_ORIGINS.
# API_HOST=https://api.midominio.com/api/

# ── Alta del primer usuario ──────────────────────────────────────────────────
# Usadas solo por `make seed-user USERNAME=... PASSWORD=...` (packages/api/src/
# scripts/seed-user.ts) para crear el usuario inicial. No hace falta dejarlas
# puestas en el .env real: pásalas puntualmente en la línea de comandos.
# INIT_USERNAME=
# INIT_PASSWORD=
