# Resolver embebido de Docker: permite que "api" (o cualquier hostname de
# ${API_UPSTREAM}) se resuelva en cada petición en vez de una sola vez al
# arrancar. Sin esto, si el hostname no resuelve en el momento del arranque
# (orden de arranque, reinicio del otro contenedor...) nginx no arranca.
resolver 127.0.0.11 valid=10s;

server {

  listen 3009;

  location /api/ {
    # proxy_pass sin URI: con variables nginx NO recorta/reescribe el path
    # (esa reescritura solo pasa con un proxy_pass literal), así que hay que
    # reenviar la petición tal cual para no perder todo lo que va tras /api/.
    set $upstream_api ${API_UPSTREAM};
    proxy_pass http://$upstream_api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Anclado al inicio de la ruta para casar solo con los ficheros reales del
  # service worker en la raíz (/sw.js, /registerSW.js), no con cualquier
  # nombre que termine en esas letras.
  location ~* ^/(sw|registerSW)\.js$ {
    root   /usr/share/nginx/html;
    add_header Cache-Control "no-cache";
  }

  # Los assets de Vite llevan un hash en el nombre (ej: index-DZlMdFqK.js): un
  # cambio de contenido siempre genera un nombre nuevo, así que es seguro
  # cachearlos de forma agresiva y evitar revalidarlos en cada carga.
  location ~* \.(js|css|png|jpg|jpeg|svg|ico|woff2)$ {
    root   /usr/share/nginx/html;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # index.html sí debe revalidarse siempre: es el único fichero sin hash y el
  # que referencia los nombres (con hash) de los assets vigentes.
  location = /index.html {
    root   /usr/share/nginx/html;
    add_header Cache-Control "no-cache";
  }

  location / {
    root   /usr/share/nginx/html;
    index  index.html index.htm;
    try_files $uri $uri/ /index.html;
  }

}
