    "@mui/x-date-pickers": "9.11.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-virtual": "3.14.9",
    "axios": "1.19.0",
    "dayjs": "1.11.20",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-promise": "7.3.0",
    "jwt-decode": "4.0.0",
    "react": "19.2.6",
    "react-device-detect": "2.2.3",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.0",
    "react-router": "7.18.2",
